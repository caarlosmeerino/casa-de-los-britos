# Casa de los Britos · ajustes del servidor (Apache)
Options -Indexes
DirectoryIndex index.html index.php

# Subida de imágenes desde el panel (hasta 8 MB)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
</IfModule>

# Archivos que no deben verse desde fuera
<FilesMatch "^(\.|_|PRODUCT\.md|.*\.mjs$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------------------------------------------------------------
# Direcciones limpias: /carta en vez de /carta.html
# (si la web se instala en una subcarpeta, añadir: RewriteBase /subcarpeta/)
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Las direcciones antiguas con .html redirigen a la limpia (301)
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+blog\.php[\s?] [NC]
  RewriteRule ^ /blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+entrada\.php\?s=([a-z0-9-]+)[\s&] [NC]
  RewriteRule ^ /blog/%1? [R=301,L]

  # Barra final → sin barra (las rutas relativas dependen de ello)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Blog: /blog y /blog/nombre-de-la-entrada
  RewriteRule ^blog$ blog.php [L]
  RewriteRule ^blog/([a-z0-9-]+)$ entrada.php?s=$1 [L,QSA]

  # Páginas: /carta sirve carta.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /index.html
