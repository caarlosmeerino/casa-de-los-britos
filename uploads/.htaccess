# En las imágenes subidas no se ejecuta ningún código
<FilesMatch "\.(php|phtml|phar|php\d|pl|py|cgi|sh|html?|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
Options -Indexes
